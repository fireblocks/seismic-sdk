{
  "name": "@fireblocks/seismic-sdk",
  "version": "1.0.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "fireblocks",
    "seismic",
    "blockchain",
    "sdk",
    "ethereum",
    "evm",
    "privacy"
  ],
  "author": "Fireblocks",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "build:w": "tsc -w",
    "prepare": "npm run build",
    "start": "node ./dist/app.js",
    "dev": "tsc -w & node --watch ./dist/app.js",
    "docker:dev": "npm run build && npm start",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src"
  },
  "overrides": {
    "brace-expansion": "2.0.1",
    "ts-api-utils": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fireblocks/ts-sdk": "^13.0.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "axios": "^1.15.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "seismic-viem": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "viem": "2.45.2",
    "zod": "^4.1.13"
  }
}
