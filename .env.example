PORT=8000

# Fireblocks API credentials
FIREBLOCKS_API_USER_KEY=your-api-key-uuid
FIREBLOCKS_API_USER_SECRET_KEY_PATH=/path/to/fireblocks_secret.key

# Fireblocks API region: US | EU | SANDBOX
BASE_PATH=US

# Network: testnet is the default (opt-out). Omitting NETWORK or setting it to any
# value other than "mainnet" selects testnet. Setting NETWORK=mainnet will fail at
# startup with a clear error — mainnet is not yet live.
# NETWORK=mainnet

# Optional: override RPC URL
# Defaults: testnet=https://testnet-1.seismictest.net/rpc, mainnet=<pending when live>
RPC_URL=

# Optional: SocialScan Explorer API key for extended transaction history.
SOCIALSCAN_API_KEY=

# Optional: Directory where tx-log.ndjson is written (default: current working dir).
# Each broadcast appends one JSON line: { timestamp, vault, type, to, amount, contract?, nonce?, txHash }
TX_LOG_DIR=.

# Optional: HTTP client timeout in milliseconds (default: 30000)
HTTP_TIMEOUT=30000

# Optional: HTTP User-Agent header (default: @fireblocks/seismic-sdk/<version>)
HTTP_USER_AGENT=

# Optional: logging level (DEBUG | INFO | WARN | ERROR | NONE; case-insensitive, default: INFO)
LOG_LEVEL=INFO

# Optional: skip deterministic signing check at startup (default: false)
# The SDK verifies that your Fireblocks workspace supports deterministic signing by signing a fixed
# message twice and comparing the results. Set to "true" only if you have confirmed your workspace
# has deterministic signing enabled in its settings.
SKIP_DETERMINISM_CHECK=false