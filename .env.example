PORT=8000

# Fireblocks API credentials
FIREBLOCKS_API_USER_KEY=your-api-key-uuid
FIREBLOCKS_API_USER_SECRET_KEY_PATH=/path/to/fireblocks_secret.key

# Fireblocks API region: US | EU | SANDBOX
BASE_PATH=US

# Network: mainnet | testnet (default: mainnet)
NETWORK=mainnet

# Optional: override RPC URL (defaults to network constant if not set)
RPC_URL=
